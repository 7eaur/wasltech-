{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vnext:build:release",
  "outputDirectory": "dist-release",
  "trailingSlash": true,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/en(?:/.*)?",
      "status": 404,
      "dest": "/en/404.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
