{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vnext:build:release",
  "outputDirectory": "dist-release",
  "trailingSlash": true,
  "routes": [
    {
      "src": "/assets/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/en/index\\.html",
      "headers": {
        "Location": "/en/"
      },
      "status": 308
    },
    {
      "src": "/about\\.html",
      "headers": {
        "Location": "/about/"
      },
      "status": 308
    },
    {
      "src": "/contact\\.html",
      "headers": {
        "Location": "/contact/"
      },
      "status": 308
    },
    {
      "src": "/services\\.html",
      "headers": {
        "Location": "/services/"
      },
      "status": 308
    },
    {
      "src": "/portfolio\\.html",
      "headers": {
        "Location": "/portfolio/"
      },
      "status": 308
    },
    {
      "src": "/process\\.html",
      "headers": {
        "Location": "/process/"
      },
      "status": 308
    },
    {
      "src": "/faq\\.html",
      "headers": {
        "Location": "/faq/"
      },
      "status": 308
    },
    {
      "src": "/blog\\.html",
      "headers": {
        "Location": "/insights/"
      },
      "status": 308
    },
    {
      "src": "/en/service-web(?:\\.html|/)?",
      "dest": "/api/legacy-service?language=en"
    },
    {
      "src": "/service-web(?:\\.html|/)?",
      "dest": "/api/legacy-service?language=ar"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/en(?:/.*)?",
      "status": 404,
      "dest": "/en/404.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
