{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vnext:build:release",
  "outputDirectory": "dist-release",
  "trailingSlash": true,
  "routes": [
    {
      "src": "/assets/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    {
      "src": "/service-web/?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/en/service-web/?",
      "status": 404,
      "dest": "/en/404.html"
    },
    {
      "src": "/service-web\\.html",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/en/service-web\\.html",
      "status": 404,
      "dest": "/en/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/en(?:/.*)?",
      "status": 404,
      "dest": "/en/404.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/about.html",
